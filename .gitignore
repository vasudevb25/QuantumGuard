# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Virtual environments ---
# Listed explicitly: they are otherwise ignored only by the `*` .gitignore
# that `python -m venv` drops inside them, which other tools don't create.
venv/
.venv/
env/
logy/
.quantum/
pyvenv.cfg

# --- eBPF build output (regenerated by `make -C ebpf`) ---
ebpf/loader
ebpf/*.o
ebpf/*.skel.h

# --- Pipeline output - regenerated by main.py, never source ---
# Phase 2/3 graph, Phase 4 model, Phase 1-6 evidence/certificates/JSON
# store, Phase 6 anchor ledger, Phase 7 report, atomic-write temp files
graphs/
models/
evidence/
ledger/
evaluation/report.json
*.tmp

# --- Secrets / key material ---
# keys/ holds the encrypted signing keys (crypto.integrity.KeyStore);
# .env is where QG_KEYSTORE_PASSPHRASE / QG_DB_URL belong.
keys/
.env
.env.*
*.pem
*.key

# --- Editor / OS cruft ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log
